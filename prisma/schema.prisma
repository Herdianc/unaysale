generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  RENTED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum TransactionType {
  DIJUAL
  DISEWA
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  password      String
  image         String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  properties      Property[]
  favorites       Favorite[]
  leads           Lead[]
  notifications   Notification[]
  agent           Agent?

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

}

model Agent {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  bio         String?
  license     String?
  whatsapp    String?
  isVerified  Boolean  @default(false)
  rating      Float    @default(0)
  totalSales  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  leads      Lead[]

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  properties Property[]

  @@index([slug])
}

model Province {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]

  @@index([slug])
}

model City {
  id         String   @id @default(cuid())
  name       String
  slug       String
  provinceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts  District[]

  @@index([slug])
  @@index([provinceId])
}

model District {
  id        String   @id @default(cuid())
  name      String
  slug      String
  cityId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  villages   Village[]
  properties Property[]

  @@index([slug])
  @@index([cityId])
}

model Village {
  id         String   @id @default(cuid())
  name       String
  slug       String
  districtId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  properties Property[]

  @@index([slug])
  @@index([districtId])
}

model Facility {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties PropertyFacility[]

  @@index([slug])
}

model Property {
  id               String   @id @default(cuid())
  code             String?  @unique
  title           String
  slug            String         @unique
  description     String
  transactionType TransactionType
  status          PropertyStatus @default(DRAFT)
  price           Float
  priceNegotiable Boolean        @default(false)
  isFeatured      Boolean        @default(false)
  categoryId      String
  agentId         String?
  userId          String
  districtId      String?
  villageId       String?
  address         String?
  latitude        Float?
  longitude       Float?
  metaTitle       String?
  metaDescription String?
  keywords        String?
  views           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id])
  agent       Agent?             @relation(fields: [agentId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  district    District?          @relation(fields: [districtId], references: [id])
  village     Village?           @relation(fields: [villageId], references: [id])
  images      PropertyImage[]
  specs       PropertySpec?
  legalities  PropertyLegal?
  facilities  PropertyFacility[]
  favorites   Favorite[]
  leads       Lead[]
  views_log   PropertyView[]

  @@index([slug])
  @@index([categoryId])
  @@index([agentId])
  @@index([userId])
  @@index([districtId])
  @@index([status])
  @@index([transactionType])
  @@index([price])
  @@index([createdAt])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertySpec {
  id             String  @id @default(cuid())
  propertyId     String  @unique
  landArea       Float?
  buildingArea   Float?
  bedrooms       Int?
  bathrooms      Int?
  floors         Int?
  carport        Int?
  garage         Int?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyLegal {
  id         String  @id @default(cuid())
  propertyId String  @unique
  certificate String?
  pbb        Boolean @default(false)
  imb        Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyFacility {
  id         String @id @default(cuid())
  propertyId String
  facilityId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([facilityId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
}

model Lead {
  id         String     @id @default(cuid())
  propertyId String
  userId     String?
  agentId    String?
  name       String
  phone      String
  email      String?
  message    String?
  source     String     @default("website")
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([agentId])
  @@index([userId])
  @@index([status])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}
